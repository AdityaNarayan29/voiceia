# Required:
# - Chat (LLM): llama-3.3-70b-versatile via Groq
# - Speech-to-text fallback: whisper-large-v3 via Groq
GROQ_API_KEY=

# Optional: local Kokoro TTS for high-quality chat audio.
# The browser hits this URL directly (CORS-friendly) so audio streams
# without Next.js buffering. Falls back to browser speechSynthesis if
# unreachable.
NEXT_PUBLIC_KOKORO_URL=http://localhost:8880

NEXT_PUBLIC_APP_VERSION=0.1.0
